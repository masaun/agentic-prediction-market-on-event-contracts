# Copy to .env — sourced by contracts/deploy.sh (which runs `forge script`)
# when deploying X402FeeVault. Never committed; contracts/.env is gitignored.

# A funded Somnia-testnet wallet's private key that pays gas to deploy.
# This is a ONE-TIME deployer key — distinct from any agent's own trading
# wallet (see ../agent-servers/.env.example) and not needed again afterward.
PRIVATE_KEY="0x..."

# Somnia testnet RPC (public default shown; override if you run your own node).
SOMNIA_RPC_URL="https://dream-rpc.somnia.network"



# --- x402 (contracts/doc/x402/X402.md) ---
# tUSDC on Somnia testnet — the fee token X402FeeVault locks. See
# ../README.md's contract-address table (use USDso's address instead to
# deploy against mainnet).
FEE_TOKEN_ADDRESS="0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E"

# Optional — who can call the deployed vault's owner-only withdraw().
# Defaults to the deployer's own address (derived from PRIVATE_KEY) if unset.
VAULT_OWNER_ADDRESS="0x0A643c05dFaD42DD9f1EDdBf017BBAA9aa6d7609" # Test Agent - Deployer

# X402FeeVault.sol
X402_FEE_VAULT_ADDRESS="0x91aa603135011E65D35C74CE514779Ecb3F941A6"

# == Logs ==
#   X402FeeVault deployed at: 0x91aa603135011E65D35C74CE514779Ecb3F941A6
#     fee token:             0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
#     owner (withdraw-only): 0x...
#     identity registry:     0x37D4EF7C9F69769be1cb4E254d19692278a7cc17



# --- ERC-8004 (contracts/doc/erc8004/ERC8004.md) ---
# Required by DeployX402FeeVault.s.sol — X402FeeVault.payFee() gates on the
# caller holding an Agent-ID NFT here. Deploy IdentityRegistry first
# (npm run deploy:erc8004, or DeployERC8004.s.sol directly) and paste its
# printed address here before deploying/re-deploying X402FeeVault.
ERC8004_IDENTITY_REGISTRY_ADDRESS="0x37D4EF7C9F69769be1cb4E254d19692278a7cc17"
ERC8004_REPUTATION_REGISTRY_ADDRESS="0x97Bf2828690A74ADe4e46C21205E5612e505acCb"
ERC8004_VALIDATION_REGISTRY_ADDRESS="0x1db9A66DFB0B553Fcb8348B2fccB717395e1eCD9"

# == Logs ==
#   IdentityRegistry deployed at:   0x37D4EF7C9F69769be1cb4E254d19692278a7cc17
#   ReputationRegistry deployed at: 0x97Bf2828690A74ADe4e46C21205E5612e505acCb
#   ValidationRegistry deployed at: 0x1db9A66DFB0B553Fcb8348B2fccB717395e1eCD9