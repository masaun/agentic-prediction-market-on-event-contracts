# Copy to .env (Next.js loads it automatically).

# "mock" (default) runs a self-contained in-memory venue — no wallet, no
# testnet funds, works immediately. "live" trades real DreamDEX Event
# Contracts on Somnia via @somnia-chain/markets-sdk.
MARKET_ENGINE=mock

# --- only read when MARKET_ENGINE=live ---

# "testnet" (Shannon, chain 50312) or "mainnet" (chain 5031).
SOMNIA_NETWORK=testnet

# Override packages/market-engine/src/liveEngine.ts's own per-network defaults
# (below) only if you're pointed at a different indexer/RPC, e.g. a local
# devnet. The SDK itself has no built-in fallback — it throws
# NotConfiguredError if indexerUrl isn't supplied — so leave BOTH lines
# entirely absent (not present-but-empty) to fall through to these:
#   testnet: SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
#            SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
#   mainnet: SOMNIA_INDEXER_URL=https://prd.smk.somnia.host/v1/graphql
#            SOMNIA_WS_RPC_URL=wss://api.infra.mainnet.somnia.network/ws
SOMNIA_INDEXER_URL="https://dev.smk.somnia.host/v1/graphql"
SOMNIA_WS_RPC_URL="wss://api.infra.testnet.somnia.network/ws"

# Default/shared wallet every live write executes from when the caller has no
# dedicated wallet of its own (reads work without it; writes throw without it).
# Used for Sage (creator), external MCP agents, and any bettor whose per-agent
# key below is unset. See packages/market-engine/src/liveEngine.ts.
SOMNIA_PRIVATE_KEY=0x...

# Optional — Ada's and Nomi's own wallets, so each pays for mint_set/
# place_order/faucet from its own funded address instead of sharing
# SOMNIA_PRIVATE_KEY above. Leave either unset to fall back to the shared
# wallet for that agent. See app/src/lib/engine.ts (AGENT_WALLET_ENV) and
# "Giving Ada and Nomi their own wallets" in the root README.
ADA_AGENT_WALLET_PRIVATE_KEY=
NOMI_AGENT_WALLET_PRIVATE_KEY=

# Optional — Sage's own wallet, for POST /api/register-agent to sign her ERC-8004 registration
# from a wallet genuinely her own rather than the shared fallback. Sage never buys shares, so this
# has no effect on trading either way. Set to the same value as agent-servers/.env's
# SAGE_AGENT_WALLET_PRIVATE_KEY if you also want register_erc8004_identity (the autonomous path) to
# register that exact wallet — same "set both to the same key" pattern as Ada/Nomi's x402 wallets.
SAGE_AGENT_WALLET_PRIVATE_KEY=


# --- shared secret for agent-facing write routes (optional) ---
# If set, /api/markets (POST), /api/markets/:id/orders|buy|mint|redeem (POST),
# and /api/agents/register|:id/activity (POST) require this in the
# x-apm-agent-key header. Leave unset for a zero-config local demo.
APM_AGENT_API_KEY=

# --- x402: buying shares (BUY_YES/BUY_NO) — see contracts/doc/x402/X402.md ---
# Deployed X402FeeVault address (npm run deploy:x402vault). Only needed if
# some agent has been given its own wallet (see agent-servers/.env.example) —
# an agent with no wallet skips x402 and trades exactly as before. Unset =
# POST /api/markets/:id/buy responds 501 telling you to deploy it first.
X402_FEE_VAULT_ADDRESS="0x91aa603135011E65D35C74CE514779Ecb3F941A6"

# Optional — override the public Somnia RPC app/src/lib/x402.ts uses to
# verify an agent's on-chain fee payment. Leave unset for the public default.
SOMNIA_RPC_URL=

# --- ERC-8004: agent identity (see contracts/doc/erc8004/ERC8004.md) ---
# Deployed IdentityRegistry address (npm run deploy:erc8004). Needed for the Register tab, the
# GET /api/agents/:id/erc8004 status check, and the buy route's pre-flight registration check.
# Unset makes those paths respond 501 rather than silently skipping the check — the authoritative
# gate (X402FeeVault.payFee, once re-deployed with this registry wired in) still applies either way.
ERC8004_IDENTITY_REGISTRY_ADDRESS="0x37D4EF7C9F69769be1cb4E254d19692278a7cc17"
