# Copy to .env (this file is loaded by `dotenv/config`).

# The running app's base URL — agents only ever talk to the app over HTTP.
APM_API_URL=http://localhost:3000

# Optional shared secret; only needed if the app sets APM_AGENT_API_KEY too.
# APM_AGENT_API_KEY=

# Which LLM engine the built-in reference runtime (proxy-servers/shared/llmLoop.ts)
# uses to reason. Not needed at all if you're driving these tools from Hermes
# Agent / OpenClaw via shared/mcpServer.ts instead — see README.md.
#   openrouter (default) — one key, any model via OpenRouter's unified API.
#   anthropic            — calls the Anthropic Messages API directly.
LLM_PROVIDER=openrouter

# Required when LLM_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# OpenRouter model slug for agent reasoning — any id from https://openrouter.ai/models
# (e.g. "anthropic/claude-sonnet-4.5", "google/gemini-2.0-flash-001").
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional attribution headers OpenRouter uses for its public rankings — harmless to leave unset.
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=

# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Anthropic model id for agent reasoning, only read when LLM_PROVIDER=anthropic.
AGENT_MODEL=claude-sonnet-5

# How often each agent "wakes up" and takes a turn, in milliseconds.
AGENT_INTERVAL_MS=30000

# Only read by shared/mcpServer.ts — which agent identity MCP tool calls report under.
# AGENT_ID=agent-sage

# --- x402: this agent's own wallet, for buying shares (BUY_YES/BUY_NO only) ---
# See contracts/doc/x402/X402.md. Leave all unset to keep the original,
# App-custodied behavior (works fine against MARKET_ENGINE=mock, and against
# live DreamDEX too — it just skips x402 entirely). Setting one of these
# gives that agent its own on-chain identity: it pays the 0.01% platform fee
# into X402FeeVault and places its DreamDEX orders itself, from this key —
# the App never sees this private key.
#
# Ada's and Nomi's own wallets — each needs testnet SOMI/STT (gas) and tUSDC
# before it can do anything. Get STT from https://testnet.somnia.network/;
# fund tUSDC via the app's Faucet tab or the `faucet` tool (still
# App-custodied — faucet/mint_set/SELL_*/redeem are unaffected by all this).
ADA_AGENT_WALLET_PRIVATE_KEY=
NOMI_AGENT_WALLET_PRIVATE_KEY=

# Sage's own wallet — optional, and only relevant for register_erc8004_identity (Sage's
# place_order calls are excluded from CREATOR_TOOLS in shared/tools.ts, so she never buys or pays
# an x402 fee either way). Same funding story as Ada/Nomi above if you want her to have a genuinely
# separate on-chain identity rather than falling back to AGENT_WALLET_PRIVATE_KEY below.
SAGE_AGENT_WALLET_PRIVATE_KEY=

# Fallback for any agent not covered by a dedicated var above — used by
# external MCP agents (Hermes Agent, OpenClaw; one process = one AGENT_ID
# already, so one shared var per process is enough) and ignored for Ada/Nomi,
# who never fall back to a shared key (each keeps its own separate identity).
AGENT_WALLET_PRIVATE_KEY=

# Only read once a wallet above is set. "testnet" (Shannon, chain 50312,
# default) or "mainnet" (chain 5031) — must match the App's own
# SOMNIA_NETWORK for the fee vault + DreamDEX addresses to agree.
SOMNIA_NETWORK=testnet

# Optional — override the public Somnia RPC these wallet calls use. Leave
# unset for the public default (see proxy-servers/shared/wallet.ts).
SOMNIA_RPC_URL=

# --- ERC-8004: this agent's on-chain identity (contracts/doc/erc8004/ERC8004.md) ---
# Deployed IdentityRegistry address (npm run deploy:erc8004). Required to call the
# register_erc8004_identity tool — and, once X402FeeVault is re-deployed with this registry wired
# in, required before payFee() (and therefore any BUY_YES/BUY_NO) will succeed at all for this
# agent's wallet.
ERC8004_IDENTITY_REGISTRY_ADDRESS=

# Optional — override the DreamDEX/Somnia Markets indexer + chain WS RPC
# LiveEngine uses for the direct-to-DreamDEX order call (step 2 of the x402
# buy flow). Leave both entirely absent to use the SDK's own per-network
# defaults — see "SOMNIA_INDEXER_URL / SOMNIA_WS_RPC_URL" in app/README.md.
# SOMNIA_INDEXER_URL=
# SOMNIA_WS_RPC_URL=

# Ports for the OpenAI-compatible chat servers (creator-agent/chatServer.ts,
# bettor-agent/chatServer.ts) that a chat UI like Open WebUI talks to. See README.md.
CREATOR_CHAT_PORT=4001
BETTOR_CHAT_PORT=4002

# Optional bearer token the chat servers require in `Authorization: Bearer <key>`.
# Set the same value as the "API key" on Open WebUI's connection if you set this.
# AGENT_CHAT_API_KEY=
